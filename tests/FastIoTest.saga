module FastIoTest

import Std.Test (Testing, describe, test, assert_eq)
import Std.BitString as BS
import SagaJson.FastIo as F

# Build a String from raw bytes — for testing sub-0x20 escape behavior
# where the source code can't easily contain the literal byte.
fun bytes_to_string : BitString -> String
bytes_to_string bs = case BS.to_string bs {
  Ok s -> s
  Err _ -> "<<invalid utf-8 in test fixture>>"
}

pub fun tests : Unit -> Unit needs {Testing}
tests () = {
  describe "FastIo" (fun () -> {
    describe "primitive serialize" (fun () -> {
      test "int" (fun () -> assert_eq (F.serialize 42) "42")
      test "float" (fun () -> assert_eq (F.serialize 3.5) "3.5")
      test "bool true" (fun () -> assert_eq (F.serialize True) "true")
      test "bool false" (fun () -> assert_eq (F.serialize False) "false")
      test "clean string" (fun () ->
        assert_eq (F.serialize "hello world") "\"hello world\"")
      test "empty string" (fun () -> assert_eq (F.serialize "") "\"\"")
    })

    describe "string escaping (scan-and-slice)" (fun () -> {
      test "quote" (fun () ->
        assert_eq (F.escape_string (bytes_to_string (BS.from_list [97, 34, 98])))
          "\"a\\\"b\"")
      test "backslash" (fun () ->
        assert_eq (F.escape_string (bytes_to_string (BS.from_list [92])))
          "\"\\\\\"")
      test "newline + tab" (fun () ->
        assert_eq (F.escape_string (bytes_to_string (BS.from_list [10, 9])))
          "\"\\n\\t\"")
      test "control char -> \\u00XX" (fun () ->
        assert_eq (F.escape_string (bytes_to_string (BS.from_list [1])))
          "\"\\u0001\"")
      test "clean run preserved between escapes" (fun () ->
        assert_eq (F.escape_string (bytes_to_string (BS.from_list [
          120, 121, 34, 122,
        ])))
          "\"xy\\\"z\"")
      test "multibyte utf-8 passes through (é)" (fun () ->
        assert_eq (F.escape_string (bytes_to_string (BS.from_list [195, 169])))
          (bytes_to_string (BS.from_list [34, 195, 169, 34])))
    })

    describe "containers" (fun () -> {
      test "list of ints" (fun () -> assert_eq (F.serialize [1, 2, 3]) "[1,2,3]")
      test "empty list" (fun () -> assert_eq (F.serialize ([] : List Int)) "[]")
      test "list of strings escapes each" (fun () ->
        assert_eq (F.serialize ["a", "b\"c"]) "[\"a\",\"b\\\"c\"]")
      test "maybe just" (fun () -> assert_eq (F.serialize (Just 7)) "7")
      test "maybe nothing" (fun () ->
        assert_eq (F.serialize (Nothing : Maybe Int)) "null")
      test "nested list" (fun () ->
        assert_eq (F.serialize [[1, 2], [3]]) "[[1,2],[3]]")
    })
  })
}
