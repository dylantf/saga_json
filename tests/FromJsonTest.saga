module FromJsonTest

import Std.Fail (Fail)
import Std.Test (Testing, Test, describe, test, assert_eq, assert_ok, assert_err)
import SagaJson as J (
  Options,
  NameStyle,
  TagFormat,
  default_options,
  CamelCase,
)
import SagaJson.Encode as E (ToJson, serialize, serialize_with)
import SagaJson.Decode as D (FromJson, deserialize, deserialize_with, refine)

# --- Types under test ---
#
# Mirror DerivingTest's shapes so the round-trip exercises every
# encoder-side feature with a symmetric decoder.

record Coords {
  lat: Float,
  lng: Float,
} deriving (Debug, Eq, ToJson, FromJson)

record Address {
  street: String,
  city: String,
  zip: String,
  coords: Coords,
} deriving (Debug, Eq, ToJson, FromJson)

record User {
  id: Int,
  name: String,
  active: Bool,
  manager: Maybe String,
  balance: Float,
  roles: List String,
  address: Address,
  tags: List String,
} deriving (Debug, Eq, ToJson, FromJson)

type Role =
  | Admin
  | Editor
  | Viewer
  deriving (Debug, Eq, ToJson, FromJson)

# Multi-arg / unit / single-arg variants in one ADT, so the Variant +
# FromJsonArgs paths get round-tripped together.
type Shape =
  | Triangle
  | Circle Int
  | Rect Int Int
  deriving (Debug, Eq, ToJson, FromJson)

record Person {
  name: String,
  age: Int,
} deriving (Debug, Eq, ToJson, FromJson)

# Helpers
fun sample_user : Unit -> User
sample_user () = User {
  id: 42,
  name: "Alice",
  active: True,
  manager: Just "Bob",
  balance: 1234.56,
  roles: ["admin", "editor"],
  address: Address {
    street: "123 Main St",
    city: "Springfield",
    zip: "12345",
    coords: Coords { lat: 40.7128, lng: -74.006 },
  },
  tags: [],
}

# Invariant for refine: age must be non-negative.
fun nonneg_age : Person -> Person needs {Fail J.Error}
nonneg_age p = if p.age >= 0 then p
  else fail! (J.InvalidShape "age >= 0" "negative" ["age"])

pub fun tests : Unit -> Unit needs {Testing}
tests () = {
  describe "FromJson" (fun () -> {
    describe "round-trip via trait dispatch" (fun () -> {
      test "primitives round-trip" (fun () -> {
        assert_eq (deserialize (serialize "hi") : Result String J.Error) (Ok "hi")
        assert_eq (deserialize (serialize 42) : Result Int J.Error) (Ok 42)
        assert_eq (deserialize (serialize 1.5) : Result Float J.Error) (Ok 1.5)
        assert_eq (deserialize (serialize True) : Result Bool J.Error) (Ok True)
      })

      test "List round-trips" (fun () ->
        assert_eq
          (deserialize (serialize [1, 2, 3]) : Result (List Int) J.Error)
          (Ok [1, 2, 3]))

      test "Maybe round-trips Just" (fun () ->
        assert_eq
          (deserialize (serialize (Just 7 : Maybe Int)) : Result (Maybe Int) J.Error)
          (Ok (Just 7)))

      test "Maybe round-trips Nothing" (fun () ->
        assert_eq
          (deserialize (serialize (Nothing : Maybe Int)) : Result (Maybe Int) J.Error)
          (Ok Nothing))

      test "flat record (Coords)" (fun () -> {
        let c = Coords { lat: 1.0, lng: 2.0 }
        assert_eq (deserialize (serialize c) : Result Coords J.Error) (Ok c)
      })

      test "nested record (Address)" (fun () -> {
        let a = Address {
          street: "s", city: "c", zip: "z",
          coords: Coords { lat: 1.0, lng: 2.0 },
        }
        assert_eq (deserialize (serialize a) : Result Address J.Error) (Ok a)
      })

      test "complex record with Maybe/List (User)" (fun () -> {
        let u = sample_user ()
        assert_eq (deserialize (serialize u) : Result User J.Error) (Ok u)
      })

      # The headline test for Phase 6: sum-type decoding actually picks the
      # right variant because Phase 5's Symbol migration made Variant n a
      # discriminable at the type level.
      test "ADT Role: Admin round-trips" (fun () ->
        assert_eq (deserialize (serialize Admin) : Result Role J.Error) (Ok Admin))

      test "ADT Role: Editor round-trips (not Admin via Or left-bias)" (fun () ->
        assert_eq (deserialize (serialize Editor) : Result Role J.Error) (Ok Editor))

      test "ADT Role: Viewer round-trips (rightmost branch)" (fun () ->
        assert_eq (deserialize (serialize Viewer) : Result Role J.Error) (Ok Viewer))

      test "ADT Shape: unit variant Triangle" (fun () ->
        assert_eq (deserialize (serialize Triangle) : Result Shape J.Error) (Ok Triangle))

      test "ADT Shape: single-arg Circle" (fun () ->
        assert_eq (deserialize (serialize (Circle 7)) : Result Shape J.Error) (Ok (Circle 7)))

      test "ADT Shape: multi-arg Rect" (fun () ->
        assert_eq (deserialize (serialize (Rect 3 4)) : Result Shape J.Error) (Ok (Rect 3 4)))
    })

    describe "Options symmetry" (fun () -> {
      test "rename_all: CamelCase round-trips through nested record" (fun () -> {
        let u = sample_user ()
        let opts = { default_options | rename_all: CamelCase }
        let encoded = serialize_with opts u
        assert_eq (deserialize_with opts encoded : Result User J.Error) (Ok u)
      })
    })

    describe "failure paths" (fun () -> {
      # Or exhausts all variants; the final branch's tag-mismatch failure
      # propagates as the user-visible error.
      test "tag mismatch on Role surfaces Fail Error" (fun () ->
        assert_err (deserialize "{\"NotAVariant\":null}" : Result Role J.Error))

      test "missing field on Person surfaces Fail Error" (fun () -> {
        let r = deserialize "{\"name\":\"Alice\"}" : Result Person J.Error
        case r {
          Err (J.InvalidShape exp _ _) ->
            # error message names the missing field
            assert! True $"got expected error: {exp}"
          other -> assert! False $"expected missing-field error, got {debug other}"
        }
      })

      test "wrong-typed field on Person surfaces Fail Error" (fun () ->
        assert_err
          (deserialize "{\"name\":\"Alice\",\"age\":\"thirty\"}" : Result Person J.Error))
    })

    describe "refine" (fun () -> {
      test "accepts value matching invariant" (fun () -> {
        let dec = refine nonneg_age (fun jj -> from_json_with default_options jj)
        let got = J.parse dec "{\"name\":\"Ada\",\"age\":30}"
        assert_eq got (Ok (Person { name: "Ada", age: 30 }))
      })

      test "rejects value violating invariant" (fun () -> {
        let dec = refine nonneg_age (fun jj -> from_json_with default_options jj)
        let got = J.parse dec "{\"name\":\"Ada\",\"age\":-1}"
        case got {
          Err (J.InvalidShape "age >= 0" "negative" _) -> assert! True ""
          other -> assert! False $"expected refine failure, got {debug other}"
        }
      })
    })
  })
}
