#@ JSON tokenizer and parser
#@
#@ Produces a `Value` ADT mirroring the JSON spec. Used internally by
#@ SagaJson; consumers go through the `Json` opaque type and decoders.
module SagaJson.Parser

import Std.Base (Show, Debug, Eq, Ord, Semigroup, Enum)
import Std.BitString as BS
import Std.Float
import Std.Int
import Std.List
import Std.Maybe

#@ A parsed JSON value. Mirrors RFC 8259's grammar.
pub type Value =
  | VNull
  | VBool Bool
  | VInt Int
  | VFloat Float
  | VString String
  | VArray (List Value)
  | VObject (List (String, Value))
  deriving (Eq, Debug)

# --- Whitespace ---

fun skip_ws : BitString -> BitString
skip_ws bs = case bs {
  <<32, rest/binary>> -> skip_ws rest # space
  <<9, rest/binary>> -> skip_ws rest # tab
  <<10, rest/binary>> -> skip_ws rest # \n
  <<13, rest/binary>> -> skip_ws rest # \r
  _ -> bs
}

# --- Top-level dispatch ---

fun parse_value : BitString -> Result (Value, BitString) String
parse_value bs = {
  let s = skip_ws bs
  case s {
    <<"null", t/binary>> -> Ok (VNull, t)
    <<"true", t/binary>> -> Ok (VBool True, t)
    <<"false", t/binary>> -> Ok (VBool False, t)
    <<34, _/binary>> -> parse_string s # 34 = "
    <<91, _/binary>> -> parse_array s # 91 = [
    <<123, _/binary>> -> parse_object s # 123 = {
    <<c:8, _/binary>> when c == 45 || c >= 48 && c <= 57 -> parse_number s
    _ -> Err "expected JSON value"
  }
}

# --- Strings ---

fun escape_byte : Int -> Maybe Int
escape_byte 34 = Just 34 # \"
escape_byte 92 = Just 92 # \\
escape_byte 47 = Just 47 # \/
escape_byte 98 = Just 8 # \b
escape_byte 102 = Just 12 # \f
escape_byte 110 = Just 10 # \n
escape_byte 114 = Just 13 # \r
escape_byte 116 = Just 9 # \t
escape_byte _ = Nothing

# Scan a string body and collect its decoded content as a list of binary
# chunks. `body` is the full content binary (just past the opening quote);
# `skip`/`len` are the offset and length of the current unescaped run;
# `rem` is the unconsumed tail; `acc` is the chunk list in reverse order.
# Unescaped runs are sliced from `body`; escape sequences contribute their
# decoded byte. A string with no escapes is a single chunk.
#
# Chunks are not UTF-8 validated: `body` is valid by contract and run
# boundaries fall only on the ASCII bytes `"` and `\`, never inside a
# multi-byte sequence, so each chunk is valid.
fun parse_string_body : BitString -> Int -> Int -> BitString -> List BitString -> Result (String, BitString) String
parse_string_body body skip len rem acc = case rem {
  <<34, rest/binary>> -> case flush_chunk body skip len acc {
    [single] -> Ok (BS.to_string_unchecked single, rest)
    chunks -> Ok (BS.to_string_unchecked (BS.concat (List.reverse chunks)), rest)
  }
  <<92, 117, _/binary>> -> Err "\\u escapes not yet supported"
  <<92, c:8, rest/binary>> -> case escape_byte c {
    Just b -> parse_string_body body (skip + len + 2) 0 rest (BS.from_byte b :: flush_chunk body skip len acc)
    Nothing -> Err $"invalid escape sequence: \\{c}"
  }
  <<_c:8, rest/binary>> -> parse_string_body body skip (len + 1) rest acc
  _ -> Err "unterminated string"
}

# Emit the clean run [skip, skip+len) as a single zero-copy slice, if non-empty.
fun flush_chunk : BitString -> Int -> Int -> List BitString -> List BitString
flush_chunk body skip len acc =
  if len > 0 then BS.slice skip len body :: acc else acc

fun parse_string : BitString -> Result (Value, BitString) String
parse_string bs = case bs {
  <<34, rest/binary>> -> case parse_string_body rest 0 0 rest [] {
    Ok (s, t) -> Ok (VString s, t)
    Err e -> Err e
  }
  _ -> Err "expected string"
}

# --- Numbers ---

# Scan the number bytes, returning (length, tail, is_float). The caller
# slices the digits out of the original binary; `is_float` is True when a
# `.`, `e` or `E` appears among them.
fun take_number_loop : BitString -> Int -> Bool -> (Int, BitString, Bool)
take_number_loop rem len is_float = case rem {
  # digit (0-9), '-' or '+': part of the number, not a float marker
  <<c:8, rest/binary>> when c >= 48 && c <= 57 || c == 45 || c == 43 ->
    take_number_loop rest (len + 1) is_float
  # '.', 'e' or 'E': makes it a float
  <<c:8, rest/binary>> when c == 46 || c == 101 || c == 69 ->
    take_number_loop rest (len + 1) True
  _ -> (len, rem, is_float)
}

fun parse_number : BitString -> Result (Value, BitString) String
parse_number bs = {
  let (len, rest, is_float) = take_number_loop bs 0 False
  # Number bytes are all ASCII (matched by the digit/sign/exponent guards),
  # so the zero-copy slice is valid UTF-8 — no validation pass needed.
  let s = BS.to_string_unchecked (BS.slice 0 len bs)
  if is_float then case Float.parse s {
    Just f -> Ok (VFloat f, rest)
    Nothing -> Err $"invalid float: {s}"
  }
  else case Int.parse s {
    Just n -> Ok (VInt n, rest)
    Nothing -> Err $"invalid int: {s}"
  }
}

# --- Arrays ---

fun parse_array_items : BitString -> List Value -> Result (Value, BitString) String
parse_array_items bs acc = case parse_value bs {
  Err e -> Err e
  Ok (v, rest) -> {
    let r = skip_ws rest
    case r {
      <<44, t/binary>> -> parse_array_items t (v :: acc) # ','
      <<93, t/binary>> -> Ok (VArray (List.reverse (v :: acc)), t) # ']'
      _ -> Err "expected ',' or ']' in array"
    }
  }
}

fun parse_array : BitString -> Result (Value, BitString) String
parse_array bs = case bs {
  <<91, rest/binary>> -> {
    let r = skip_ws rest
    case r {
      <<93, t/binary>> -> Ok (VArray [], t) # empty array
      _ -> parse_array_items r []
    }
  }
  _ -> Err "expected array"
}

# --- Objects ---

fun parse_object_key : BitString -> Result (String, BitString) String
parse_object_key bs = case bs {
  <<34, rest/binary>> -> parse_string_body rest 0 0 rest []
  _ -> Err "expected string key in object"
}

fun parse_object_pairs : BitString -> List (String, Value) -> Result (Value, BitString) String
parse_object_pairs bs acc = case parse_object_key (skip_ws bs) {
  Err e -> Err e
  Ok (key, after_key) -> {
    let after_colon = skip_ws after_key
    case after_colon {
      <<58, after_colon_rest/binary>> -> case parse_value after_colon_rest {
        Err e -> Err e
        Ok (v, rest) -> {
          let r = skip_ws rest
          case r {
            <<44, t/binary>> -> parse_object_pairs t ((key, v) :: acc)
            <<125, t/binary>> ->
              Ok (VObject (List.reverse ((key, v) :: acc)), t)
            _ -> Err "expected ',' or '}' in object"
          }
        }
      }
      _ -> Err "expected ':' in object"
    }
  }
}

fun parse_object : BitString -> Result (Value, BitString) String
parse_object bs = case bs {
  <<123, rest/binary>> -> {
    let r = skip_ws rest
    case r {
      <<125, t/binary>> -> Ok (VObject [], t) # empty object
      _ -> parse_object_pairs r []
    }
  }
  _ -> Err "expected object"
}

# --- Top-level ---

#@ Parse a complete JSON document. Errors if there is trailing content.
pub fun parse : String -> Result Value String
parse s = {
  let bs = BS.from_string s
  case parse_value bs {
    Err e -> Err e
    Ok (v, rest) -> {
      let trailing = skip_ws rest
      if BS.is_empty trailing then Ok v
      else Err "trailing content after JSON value"
    }
  }
}
