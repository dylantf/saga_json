#@ Fast-path JSON encoding. Experimental.
#@
#@ Bypasses the `Json` AST entirely: `to_json_string` produces the final
#@ JSON string directly. The deriving target (when wired up) will emit
#@ direct-emit impls that hand-build the output instead of constructing
#@ an intermediate `VObject` tree.
#@
#@ v0: no Options support, no effect threading. Hardcoded defaults
#@ (no rename, externally-tagged sums, emit nulls). The plan is to
#@ wire `JsonOptions` in once the perf shape is validated.
module SagaJson.Fast

import Std.Int
import Std.List
import Std.String
import SagaJson (Error)
import SagaJson.Escape as Escape
import SagaJson.Parser (Value)
import SagaJson.Parser as Parser

#@ Types that can render themselves directly to a JSON string. Hand-
#@ written for now; once we're happy with the perf, `deriving` will
#@ generate impls of this trait directly without going through the
#@ `Json` AST.
pub trait ToJsonString a {
  fun to_json_string : a -> String
}

# --- Primitive impls ---

impl ToJsonString for String {
  to_json_string s = escape_string s
}

impl ToJsonString for Int {
  to_json_string n = show n
}

impl ToJsonString for Float {
  to_json_string f = show f
}

impl ToJsonString for Bool {
  to_json_string b = if b then "true" else "false"
}

impl ToJsonString for Maybe a where {a: ToJsonString} {
  to_json_string m = case m {
    Nothing -> "null"
    Just x -> to_json_string x
  }
}

impl ToJsonString for List a where {a: ToJsonString} {
  to_json_string xs = "[" <> String.join "," (List.map to_json_string xs) <> "]"
}

# --- Top-level encode entry point ---

#@ Encode a value to a compact JSON string. The fast-path equivalent of
#@ `SagaJson.Encode.serialize`.
pub fun serialize : a -> String where {a: ToJsonString}
serialize x = to_json_string x

# --- FromJsonString trait ---
#
# The decode-side fast path. `decode_value` consumes a parsed `Value`
# directly with hand-coded field lookups, skipping the Generic Rep
# walk that `SagaJson.Decode.from_json` does. No effect machinery —
# failures land as `Err Error`.

pub trait FromJsonString a {
  fun decode_value : Value -> Result a Error
}

# --- Primitive impls ---

impl FromJsonString for String {
  decode_value v = case v {
    VString s -> Ok s
    other -> Err (InvalidShape "String" (classify other) [])
  }
}

impl FromJsonString for Int {
  decode_value v = case v {
    VInt n -> Ok n
    other -> Err (InvalidShape "Int" (classify other) [])
  }
}

impl FromJsonString for Float {
  decode_value v = case v {
    VFloat f -> Ok f
    VInt n -> Ok (Int.to_float n)
    other -> Err (InvalidShape "Float" (classify other) [])
  }
}

impl FromJsonString for Bool {
  decode_value v = case v {
    VBool b -> Ok b
    other -> Err (InvalidShape "Bool" (classify other) [])
  }
}

impl FromJsonString for Maybe a where {a: FromJsonString} {
  decode_value v = case v {
    VNull -> Ok Nothing
    _ -> case decode_value v {
      Ok x -> Ok (Just x)
      Err e -> Err e
    }
  }
}

impl FromJsonString for List a where {a: FromJsonString} {
  decode_value v = case v {
    VArray items -> decode_list items []
    other -> Err (InvalidShape "Array" (classify other) [])
  }
}

fun decode_list : List Value -> List a -> Result (List a) Error
  where {a: FromJsonString}
decode_list items acc = case items {
  [] -> Ok (List.reverse acc)
  x :: rest -> case decode_value x {
    Ok v -> decode_list rest (v :: acc)
    Err e -> Err e
  }
}

# --- Top-level decode entry point ---

#@ Parse a JSON string and decode it via the `FromJsonString` trait.
#@ The fast-path equivalent of `SagaJson.Decode.deserialize`.
pub fun deserialize : String -> Result a Error where {a: FromJsonString}
deserialize s = case Parser.parse s {
  Ok v -> decode_value v
  Err msg -> Err (InvalidJson msg)
}

# --- Value classification (for error messages) ---

fun classify : Value -> String
classify v = case v {
  VNull -> "null"
  VBool _ -> "Bool"
  VInt _ -> "Int"
  VFloat _ -> "Float"
  VString _ -> "String"
  VArray _ -> "Array"
  VObject _ -> "Object"
}

#@ Look up a key on a parsed JSON object. Returns Err InvalidShape with
#@ a "field missing" message if absent. Used by hand-written
#@ `FromJsonString` impls to extract record fields.
pub fun lookup_field : String -> List (String, Value) -> Result Value Error
lookup_field key pairs = case pairs {
  [] -> Err (InvalidShape $"field '{key}'" "missing" [key])
  (k, v) :: rest -> if k == key then Ok v else lookup_field key rest
}

#@ Look up a key and decode it via FromJsonString. Convenience wrapper
#@ that combines `lookup_field` and `decode_value`.
pub fun decode_field : String -> List (String, Value) -> Result a Error
  where {a: FromJsonString}
decode_field key pairs = case lookup_field key pairs {
  Ok v -> decode_value v
  Err e -> Err e
}

#@ Expect the input value to be a JSON object; return its (key, value)
#@ pairs. Used at the head of every record decoder.
pub fun expect_object : Value -> Result (List (String, Value)) Error
expect_object v = case v {
  VObject pairs -> Ok pairs
  other -> Err (InvalidShape "Object" (classify other) [])
}

# --- String escaping ---

#@ Escape a Saga String as a JSON-quoted string literal. Shared
#@ implementation in `SagaJson.Escape`.
pub fun escape_string : String -> String
escape_string s = Escape.escape_string s
