#@ JSON library top-level: the `Json` opaque type, the shared `Error` type,
#@ and the decoder-running entry points.
#@
#@ For encoding, see `SagaJson.Encode`. For decoding primitives and
#@ combinators, see `SagaJson.Decode`.
module SagaJson

import Std.Base (Debug, Eq)
import Std.Fail (Fail)
import Std.List
import Std.String
import SagaJson.Parser (Value)

#@ A JSON value. Opaque so the internal representation can evolve.
#@ Construct with `SagaJson.Encode` primitives; inspect with
#@ `SagaJson.Decode` combinators.
pub opaque type Json = Json Value

impl Debug for Json {
  debug j = case j {
    Json v -> debug v
  }
}

#@ Error returned when JSON parsing or decoding fails.
pub type Error =
  | InvalidJson String
  | InvalidShape (expected: String) (found: String) (path: List String)
  deriving (Eq, Debug)

handler to_result for Fail a {
  fail e = Err e
  return v = Ok v
}

# --- Opacity boundary helpers ---
#
# Library-internal: prefer `SagaJson.Encode.*` constructors and
# `SagaJson.Decode.*` combinators for normal use. These exist so the
# Encode/Decode submodules can cross the opacity boundary without
# exposing the constructor publicly.

#@ Wrap a `Value` as a `Json`. Library-internal; use `SagaJson.Encode`.
pub fun from_value : Value -> Json
from_value v = Json v

#@ Unwrap a `Json` to its underlying `Value`. Library-internal; use
#@ `SagaJson.Decode` for ordinary decoding.
pub fun to_value : Json -> Value
to_value j = case j {
  Json v -> v
}

# --- Entry points ---

# --- Shared encoder/decoder options ---
#
# Options live in the root module because both encode and decode consume
# them. Uniform knobs only — anything that names a specific field belongs
# in a hand-written impl.

#@ How record field names and variant names are transformed before
#@ emission (encode) or matched against input (decode). Source
#@ convention is snake_case Saga identifiers (the type-level Symbol
#@ reflects the source name verbatim); `rename_all` is applied to that
#@ source name symmetrically on both directions.
pub type NameStyle =
  | AsIs
  | CamelCase
  | KebabCase
  | SnakeCase
  | ScreamingSnakeCase

#@ How sum-type variants are tagged in JSON.
#@
#@ - `ExternallyTagged` (default): `{"Variant": payload}` for variants
#@    that carry a payload; unit variants emit as bare strings
#@    (`"Admin"`) when `unit_variants_as_strings` is True (the default).
#@ - `AdjacentlyTagged`: `{<tag_field>: "Variant", <content_field>: payload}` —
#@    both fields always emitted, including for unit (U1) variants where
#@    `content_field` carries `null`.
#@ - `InternallyTagged`: tag merged into the payload object as `<tag_field>`.
#@    Only well-defined when the payload renders to a JSON object (single
#@    record-valued variants) or `null` (unit variants). For primitive /
#@    array payloads the encoder falls back to `ExternallyTagged` — same
#@    restriction as serde.
#@ - `Untagged`: emit the payload directly; variant identity is lost.
pub type TagFormat =
  | ExternallyTagged
  | AdjacentlyTagged
  | InternallyTagged
  | Untagged

#@ Uniform codec options. Shared between encode and decode so a single
#@ `Options` value drives a symmetric round-trip. Construct with
#@ record-update syntax: `{ default_options | rename_all: CamelCase }`.
#@ Note: `omit_nothing` is encode-only (no-op on decode).
pub record Options {
  rename_all: NameStyle,
  omit_nothing: Bool,
  tag_format: TagFormat,
  tag_field: String,
  content_field: String,
  unit_variants_as_strings: Bool,
}

#@ The canonical defaults: no renaming, emit nulls for `Maybe Nothing`,
#@ externally-tagged sums with unit variants emitted as bare strings
#@ (matching serde, kotlinx.serialization, and most other modern JSON
#@ libraries). Set `unit_variants_as_strings: False` to recover the
#@ legacy `{"Admin": null}` shape (or use the `as_tagged` strategy).
pub val default_options = Options {
  rename_all: AsIs,
  omit_nothing: False,
  tag_format: ExternallyTagged,
  tag_field: "tag",
  content_field: "content",
  unit_variants_as_strings: True,
}

# --- Fluent options builder ---
#
# The `WithOptions` trait + free-function setters give both the encode-
# and decode-side builders (`Encoder a`, `Decoder`) a shared fluent
# vocabulary: `value |> encoder |> rename_keys CamelCase |> ...`. Each
# setter returns a new builder of the same type with one Options field
# adjusted. The trait method `map_options` is the only thing
# library-internal callers need to impl.

#@ Types that carry an `Options` value internally and let you adjust it
#@ functionally. Implemented by `SagaJson.Encode.Encoder` and
#@ `SagaJson.Decode.Decoder`. The free-function setters
#@ (`rename_keys`, `tag_format`, ...) are written against this trait
#@ so they work on both builders.
pub trait WithOptions a {
  fun map_options : (Options -> Options) -> a -> a
}

#@ Set the `rename_all` field on the builder's Options.
pub fun rename_keys : NameStyle -> a -> a where {a: WithOptions}
rename_keys ns x = map_options (fun o -> { o | rename_all: ns }) x

#@ Set `omit_nothing: True` on the builder's Options. Encode-only;
#@ no-op on the decode side.
pub fun omit_nothing : a -> a where {a: WithOptions}
omit_nothing x = map_options (fun o -> { o | omit_nothing: True }) x

#@ Set the `tag_format` field on the builder's Options.
pub fun with_tag_format : TagFormat -> a -> a where {a: WithOptions}
with_tag_format tf x = map_options (fun o -> { o | tag_format: tf }) x

#@ Set the `tag_field` name (used by AdjacentlyTagged / InternallyTagged).
pub fun with_tag_field : String -> a -> a where {a: WithOptions}
with_tag_field name x = map_options (fun o -> { o | tag_field: name }) x

#@ Set the `content_field` name (used by AdjacentlyTagged).
pub fun with_content_field : String -> a -> a where {a: WithOptions}
with_content_field name x = map_options (fun o -> { o | content_field: name }) x

#@ Set the `unit_variants_as_strings` field. Pass False to recover the
#@ legacy `{"Admin": null}` wrapped shape; True is the default.
pub fun with_unit_variants_as_strings : Bool -> a -> a where {a: WithOptions}
with_unit_variants_as_strings b x =
  map_options (fun o -> { o | unit_variants_as_strings: b }) x

# --- Name-style helpers ---
#
# Library-internal. Both encode and decode apply this transform to the
# source identifier reflected via `symbol_name`, giving symmetric
# `rename_all` semantics in both directions.

#@ Apply a NameStyle transform to a Saga source identifier (snake_case
#@ by convention). Library-internal; called by both the encoder and the
#@ decoder so a single Options value drives a symmetric round-trip.
pub fun apply_name_style : NameStyle -> String -> String
apply_name_style ns s = case ns {
  AsIs -> s
  SnakeCase -> s
  CamelCase -> snake_to_camel s
  KebabCase -> String.replace_all "_" "-" s
  ScreamingSnakeCase -> String.to_upper s
}

fun snake_to_camel : String -> String
snake_to_camel s = case String.split "_" s {
  [] -> s
  h :: rest -> h <> String.join "" (List.map capitalize rest)
}

fun capitalize : String -> String
capitalize s = {
  let n = String.length s
  if n == 0 then s
  else String.to_upper (String.slice 0 1 s) <> String.slice 1 (n - 1) s
}

#@ Parse a JSON string into a Json value, without applying a decoder.
pub fun parse_string : String -> Result Json Error
parse_string s = case SagaJson.Parser.parse s {
  Ok v -> Ok (from_value v)
  Err msg -> Err (InvalidJson msg)
}

#@ Apply a decoder to an already-parsed Json value, returning a Result.
pub fun run : (Json -> a needs {Fail Error}) -> Json -> Result a Error
run decoder j = decoder j with to_result

#@ Parse a JSON string and apply a decoder in one step.
pub fun parse : (Json -> a needs {Fail Error}) -> String -> Result a Error
parse decoder s = case parse_string s {
  Ok j -> run decoder j
  Err e -> Err e
}
