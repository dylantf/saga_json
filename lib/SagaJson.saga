#@ JSON parsing.
#@
#@ Decoders are functions `Json -> a needs {Fail Error}`. Compose by ordinary
#@ function call; failures short-circuit through the Fail handler.
#@ Use `parse` to consume a JSON string and run a decoder in one step.
module SagaJson

import Std.Base (Show, Debug, Eq, Ord, Semigroup, Enum)
import Std.Fail (Fail)
import SagaJson.Parser (Value)
import Std.Int
import Std.List

#@ A parsed JSON value. Navigate with `field`, decode with `string`, `int`, etc.
pub opaque type Json = Json Value

impl Debug for Json {
  debug j = case j {
    Json v -> debug v
  }
}

#@ Error returned when JSON parsing or decoding fails.
pub type Error =
  | InvalidJson String
  | InvalidShape (expected: String) (found: String) (path: List String)
  deriving (Eq, Debug)

handler to_result for Fail a {
  fail e = Err e
  return v = Ok v
}

# --- Helpers ---

fun unwrap : Json -> Value
unwrap j = case j {
  Json v -> v
}

fun classify : Value -> String
classify v = case v {
  VNull -> "null"
  VBool _ -> "Bool"
  VInt _ -> "Int"
  VFloat _ -> "Float"
  VString _ -> "String"
  VArray _ -> "Array"
  VObject _ -> "Object"
}

fun shape_err : String -> Json -> a needs {Fail Error}
shape_err expected j = fail! (InvalidShape expected (classify (unwrap j)) [])

# --- Entry points ---

#@ Parse a JSON string into a Json value, without applying a decoder.
pub fun parse_string : String -> Result Json Error
parse_string s = case SagaJson.Parser.parse s {
  Ok v -> Ok (Json v)
  Err msg -> Err (InvalidJson msg)
}

#@ Apply a decoder to an already-parsed Json value, returning a Result.
pub fun run : (Json -> a needs {Fail Error}) -> Json -> Result a Error
run decoder j = decoder j with to_result

#@ Parse a JSON string and apply a decoder in one step.
pub fun parse : (Json -> a needs {Fail Error}) -> String -> Result a Error
parse decoder s = case parse_string s {
  Ok j -> run decoder j
  Err e -> Err e
}

# --- Primitive decoders ---

#@ Decode a JSON string value.
pub fun string : Json -> String needs {Fail Error}
string j = case unwrap j {
  VString s -> s
  _ -> shape_err "String" j
}

#@ Decode a JSON integer value.
pub fun int : Json -> Int needs {Fail Error}
int j = case unwrap j {
  VInt n -> n
  _ -> fail! (InvalidShape "Int" (classify (unwrap j)) [])
}

#@ Decode a JSON float value. Accepts integers as floats.
pub fun float : Json -> Float needs {Fail Error}
float j = case unwrap j {
  VFloat f -> f
  VInt n -> Int.to_float n
  _ -> shape_err "Float" j
}

#@ Decode a JSON boolean value.
pub fun bool : Json -> Bool needs {Fail Error}
bool j = case unwrap j {
  VBool b -> b
  _ -> shape_err "Bool" j
}

# --- Navigation ---

fun lookup : String -> List (String, Value) -> Maybe Value
lookup _ [] = Nothing
lookup k ((k2, v) :: rest) = if k == k2 then Just v else lookup k rest

#@ Navigate to a named field in a JSON object.
pub fun field : String -> Json -> Json needs {Fail Error}
field name j = case unwrap j {
  VObject pairs -> case lookup name pairs {
    Just v -> Json v
    Nothing -> fail! (InvalidShape $"field '{name}'" "missing" [name])
  }
  _ -> fail! (InvalidShape $"Object with field '{name}'" (classify (unwrap j)) [])
}

# --- Combinators ---

fun map_each : (Json -> a needs {Fail Error, ..e}) -> List Value -> List a needs {Fail Error, ..e}
map_each f xs = case xs {
  [] -> []
  h :: t -> {
    let v = f (Json h)
    let rest = map_each f t
    v :: rest
  }
}

#@ Decode a JSON array, applying `decoder` to each element.
pub fun list_of : (Json -> a needs {Fail Error, ..e}) -> Json -> List a needs {Fail Error, ..e}
list_of decoder j = case unwrap j {
  VArray items -> map_each decoder items
  _ -> shape_err "Array" j
}

#@ Decode a JSON value that may be null. Returns Nothing for null,
#@ Just (decoder value) otherwise.
pub fun nullable : (Json -> a needs {Fail Error, ..e}) -> Json -> Maybe a needs {Fail Error, ..e}
nullable decoder j = case unwrap j {
  VNull -> Nothing
  _ -> Just (decoder j)
}
