module Main

import Std.Fail (Fail)
import Std.IO (console)
import SagaJson as J (Json)
import SagaJson.Decode as D
import SagaJson.Encode as E (ToJson, Options, NameStyle, default_options)

val user_json = """
  {
    "id": 42,
    "name": "Alice",
    "active": true,
    "manager": null,
    "balance": 1234.56,
    "roles": ["admin", "editor"],
    "address": {
      "street": "123 Main St",
      "city": "Springfield",
      "zip": "12345",
      "coords": { "lat": 40.7128, "lng": -74.006 }
    },
    "tags": []
  }
  """

val bad_shape = """
  {"id": "wrong", "name": "Alice"}
  """
val bad_syntax = """
  {"id": 1, "name":}
  """
# Deeply nested failure to exercise path prefixing.


val nested_bad = """
  {
    "id": 1, "name": "x", "active": true, "manager": null,
    "balance": 0.0, "roles": [], "tags": [],
    "address": {
      "street": "a", "city": "b", "zip": "c",
      "coords": { "lat": "not a float", "lng": 0.0 }
    }
  }
  """

record Coords {
  lat: Float,
  lng: Float,
} deriving (Debug, Eq)

record Address {
  street: String,
  city: String,
  zip: String,
  coords: Coords,
} deriving (Debug, Eq)

record User {
  id: Int,
  name: String,
  active: Bool,
  manager: Maybe String,
  balance: Float,
  roles: List String,
  address: Address,
  tags: List String,
} deriving (Debug, Eq)

fun parse_coords : Json -> Coords needs {Fail J.Error}
parse_coords json = Coords {
  lat: D.at "lat" D.float json,
  lng: D.at "lng" D.float json,
}

fun parse_address : Json -> Address needs {Fail J.Error}
parse_address json = Address {
  street: D.at "street" D.string json,
  city: D.at "city" D.string json,
  zip: D.at "zip" D.string json,
  coords: D.at "coords" parse_coords json,
}

fun parse_user : Json -> User needs {Fail J.Error}
parse_user json = User {
  id: D.at "id" D.int json,
  name: D.at "name" D.string json,
  active: D.at "active" D.bool json,
  manager: D.at "manager" (D.nullable D.string) json,
  balance: D.at "balance" D.float json,
  roles: D.at "roles" (D.list_of D.string) json,
  address: D.at "address" parse_address json,
  tags: D.at "tags" (D.list_of D.string) json,
}

# --- Phase 2: ToJson hand-written impls ---
#
# Each record gets a manual `impl ToJson`. Field types reach the right impl
# via trait resolution: `to_json u.id` dispatches to `ToJson for Int`,
# `to_json u.roles` dispatches to `ToJson for List a where {a: ToJson}`
# which in turn calls `ToJson for String`, etc.

# --- Phase 4: derived impls + Options-threading demo ---
#
# Hand-written impls (above) and derived impls (below) coexist freely.
# The hand-written impls demonstrate that the four-trait split doesn't
# disturb the manual path.

type Role =
  | Admin
  | Editor
  | Viewer
  deriving (ToJson)

record Profile {
  first_name: String,
  last_name: String,
  role: Role,
} deriving (ToJson)

record Account {
  user_info: Profile,
  account_id: Int,
} deriving (ToJson)

impl E.ToJson for Coords {
  to_json_with _ c = E.object [("lat", to_json c.lat), ("lng", to_json c.lng)]
}

impl E.ToJson for Address {
  to_json_with _ a =
    E.object [
      ("street", to_json a.street),
      ("city", to_json a.city),
      ("zip", to_json a.zip),
      ("coords", to_json a.coords),
    ]
}

impl E.ToJson for User {
  to_json_with _ u =
    E.object [
      ("id", to_json u.id),
      ("name", to_json u.name),
      ("active", to_json u.active),
      ("manager", to_json u.manager),
      ("balance", to_json u.balance),
      ("roles", to_json u.roles),
      ("address", to_json u.address),
      ("tags", to_json u.tags),
    ]
}

main () = {
  dbg "--- happy path ---"
  J.parse parse_user user_json
  |> dbg

  dbg "--- bad shape ---"
  J.parse parse_user bad_shape
  |> dbg

  dbg "--- bad syntax ---"
  J.parse parse_user bad_syntax
  |> dbg

  dbg "--- nested bad shape ---"
  J.parse parse_user nested_bad
  |> dbg

  dbg "--- Phase 1: encode edge cases ---"
  dbg (E.render (E.string ""))
  dbg (E.render (E.string "a\"b"))
  dbg (E.render (E.string "a\\b"))
  dbg (E.render (E.string "a\nb"))
  dbg (E.render (E.array []))
  dbg (E.render (E.object []))
  dbg (E.render (E.object [("nested", E.object [("k", E.int 1)])]))
  dbg (E.render (E.array [E.int 1, E.string "two", E.bool True, E.null]))

  dbg "--- Phase 4: derived ADT (externally tagged) ---"
  dbg (E.serialize Admin)
  dbg (E.serialize Editor)

  dbg "--- Phase 4: Options-threading via rename_all: CamelCase ---"
  let acct = Account {
    user_info: Profile {
      first_name: "Ada",
      last_name: "Lovelace",
      role: Admin,
    },
    account_id: 7,
  }
  let camel_opts = { default_options | rename_all: CamelCase }
  dbg (E.serialize_with camel_opts acct)

  dbg "--- Phase 2: serialize via ToJson + round-trip ---"
  case J.parse parse_user user_json {
    Err e -> dbg e
    Ok original -> {
      let rendered = E.serialize original
      dbg rendered
      case J.parse parse_user rendered {
        Err e -> dbg e
        Ok reparsed ->
          dbg (if reparsed == original then "round-trip OK"
          else "round-trip MISMATCH")
      }
    }
  }
}
