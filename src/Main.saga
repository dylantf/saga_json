module Main

import Std.Fail (Fail)
import Std.IO (console)
import SagaJson as J (Json)

val user_json = """
  {
    "id": 42,
    "name": "Alice",
    "active": true,
    "manager": null,
    "balance": 1234.56,
    "roles": ["admin", "editor"],
    "address": {
      "street": "123 Main St",
      "city": "Springfield",
      "zip": "12345",
      "coords": {
        "lat": 40.7128,
        "lng": -74.006
      }
    },
    "tags": []
  }
  """

record Coords {
  lat: Float,
  lng: Float,
} deriving (Debug)

record Address {
  street: String,
  city: String,
  zip: String,
  coords: Coords,
} deriving (Debug)

record User {
  id: Int,
  name: String,
  active: Bool,
  manager: Maybe String,
  balance: Float,
  roles: List String,
  address: Address,
  tags: List String,
} deriving (Debug)

fun parse_coords : Json -> Coords needs {Fail J.Error}
parse_coords json = Coords {
  lat: J.float (J.field "lat" json),
  lng: J.float (J.field "lng" json),
}

fun parse_address : Json -> Address needs {Fail J.Error}
parse_address json = Address {
  street: J.string (J.field "street" json),
  city: J.string (J.field "city" json),
  zip: J.string (J.field "zip" json),
  coords: parse_coords (J.field "coords" json),
}

fun parse_user : Json -> User needs {Fail J.Error}
parse_user json = User {
  id: J.int (J.field "id" json),
  name: J.string (J.field "name" json),
  active: J.bool (J.field "active" json),
  manager: J.nullable J.string (J.field "manager" json),
  balance: J.float (J.field "balance" json),
  roles: J.list_of J.string (J.field "roles" json),
  address: parse_address (J.field "address" json),
  tags: J.list_of J.string (J.field "tags" json),
}

fun show_int_err : Result Int J.Error -> String
show_int_err r = case r {
  Ok n -> $"Ok {n}"
  Err e -> case e {
    J.InvalidJson m -> $"InvalidJson {m}"
    J.InvalidShape exp found path -> $"InvalidShape expected={exp} found={found} path={debug path}"
  }
}

handler local_to_result for Fail a {
  fail e = Err e
  return v = Ok v
}

# Decoder that always fails — no JSON parsing involved.
fun always_fail : Json -> Int needs {Fail J.Error}
always_fail _j = fail! (J.InvalidShape "Int" "Whatever" [])

fun decode_int_id : Json -> Int needs {Fail J.Error}
decode_int_id j = J.int (J.field "id" j)

main () = {
  # C: J.run with decoder that uses J.int+J.field on bad input
  case J.parse_string """{"id": "wrong"}""" {
    Err _ -> println "couldn't parse"
    Ok json -> {
      let r = J.run decode_int_id json
      case r {
        Ok _ -> println "C: Ok (bad)"
        Err _ -> println "C: Err (good)"
      }
    }
  }

  # D: J.parse with same decoder
  let r2 = J.parse decode_int_id """{"id": "wrong"}"""
  case r2 {
    Ok _ -> println "D: Ok (bad)"
    Err _ -> println "D: Err (good)"
  }
} with console
