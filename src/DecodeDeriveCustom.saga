#@ Decoding with `deriving (FromJson)` plus customization via Options.
#@
#@ Options lets you adjust how the derived decoder maps between JSON and
#@ Saga types without writing the impl by hand. Common use cases: input
#@ JSON uses camelCase keys while your fields are snake_case; the input
#@ uses a different tagged-union shape than the default.
module DecodeDeriveCustom

import SagaJson as J (
  Options,
  default_options,
  CamelCase,
  AdjacentlyTagged,
)
import SagaJson.Decode as D (FromJson, deserialize_with)

# Saga fields are snake_case. With `rename_all: CamelCase` we tell the
# decoder to look up camelCase keys in the input instead.
record User {
  first_name: String,
  last_name: String,
} deriving (Debug, FromJson)

type Status =
  | Active
  | Pending
  | Closed
  deriving (Debug, FromJson)

pub fun run : Unit -> Unit
run () = {
  dbg "=== Decoding by derive with customization ==="

  # Rename: input keys are camelCase, fields are snake_case.
  let camel_opts = { default_options | rename_all: CamelCase }
  let camel_input = """{"firstName":"Ada","lastName":"Lovelace"}"""
  dbg (deserialize_with camel_opts camel_input : Result User J.Error)

  # Tag format: switch from the default external tag
  # ({"Active": null}) to adjacent ({"tag":"Active","value":null}).
  let adjacent_opts = { default_options |
    tag_format: AdjacentlyTagged,
    tag_field: "tag",
    content_field: "value",
  }
  let adjacent_input = """{"tag":"Active","value":null}"""
  dbg (deserialize_with adjacent_opts adjacent_input : Result Status J.Error)
}
