#@ Encoding Saga types into JSON by writing `ToJson` impls by hand.
#@
#@ Use this when you want full control over the output shape — custom key
#@ names, computed fields, or any JSON layout that doesn't match the type
#@ definition. A `ToJson` impl is assembled with `SagaJson.Encode` builders
#@ and rendered with `E.serialize`.
module EncodeHand

import SagaJson.Encode as E
import SagaJson.Encode (ToJson)

type Role =
  | Admin
  | Editor
  | Viewer

record Address {
  street: String,
  city: String,
}

record User {
  id: Int,
  name: String,
  email: String,
  age: Maybe Int,
  role: Role,
  address: Address,
  tags: List String,
}

impl ToJson for Role {
  to_json r = E.string (case r {
    Admin -> "Admin"
    Editor -> "Editor"
    Viewer -> "Viewer"
  })
}

impl ToJson for Address {
  to_json a =
    E.object [("street", E.string a.street), ("city", E.string a.city)]
}

impl ToJson for User {
  to_json u =
    E.object [
      ("id", to_json u.id),
      ("name", to_json u.name),
      ("email", to_json u.email),
      ("age", to_json u.age),
      ("role", to_json u.role),
      ("address", to_json u.address),
      ("tags", to_json u.tags),
    ]
}

pub fun run : Unit -> Unit
run () = {
  dbg "=== Encoding by hand ==="
  let u = User {
    id: 123,
    name: "John Smith",
    email: "john.smith@plymouth.co",
    age: Just 35,
    role: Admin,
    address: Address { street: "123 Fake St", city: "Springfield" },
    tags: ["active", "verified"],
  }
  dbg (E.serialize u)
}
