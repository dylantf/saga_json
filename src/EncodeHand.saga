#@ Encoding Saga types into JSON by writing `impl ToJson` by hand.
#@
#@ Use this when you want full control over the output shape — custom
#@ key names, computed fields, or any JSON layout that doesn't match the
#@ type definition. Build the output with the `C.object` / `C.array`
#@ builders, producing each value by recursing through `to_json opts`.
module EncodeHand

import SagaJson.Codec as C (ToJson, serialize)

record Person {
  name: String,
  age: Int,
}

# `to_json` takes the ambient Options plus the value and produces Iodata.
# Here the shape is hard-coded, so `opts` is just threaded down to each
# nested `to_json opts field` — that dispatches to the String / Int impl
# and keeps renaming/tag options flowing to nested values.
impl ToJson for Person {
  to_json opts p =
    C.object [("name", to_json opts p.name), ("age", to_json opts p.age)]
}

pub fun run : Unit -> Unit
run () = {
  dbg "=== Encoding by hand ==="
  let p = Person { name: "Alice", age: 30 }
  dbg (serialize p)
}
