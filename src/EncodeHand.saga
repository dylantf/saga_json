#@ Encoding Saga types into JSON by writing encoder functions by hand.
#@
#@ Use this when you want full control over the output shape — custom key
#@ names, computed fields, or any JSON layout that doesn't match the type
#@ definition. An encoder is just a normal function `a -> Json`, assembled
#@ with `SagaJson.Encode` builders and rendered with `E.render`.
module EncodeHand

import SagaJson (Json)
import SagaJson.Encode as E

type Role =
  | Admin
  | Editor
  | Viewer

record Address {
  street: String,
  city: String,
}

record User {
  id: Int,
  name: String,
  email: String,
  age: Maybe Int,
  role: Role,
  address: Address,
  tags: List String,
}

# A value producer returns `Json`. Plain functions replace the old trait path.
fun encode_role : Role -> Json
encode_role r =
  E.string (case r {
    Admin -> "Admin"
    Editor -> "Editor"
    Viewer -> "Viewer"
  })

fun encode_address : Address -> Json
encode_address a =
  E.object [("street", E.string a.street), ("city", E.string a.city)]

fun encode_maybe_int : Maybe Int -> Json
encode_maybe_int m = case m {
  Nothing -> E.null
  Just n -> E.int n
}

fun encode_user : User -> Json
encode_user u =
  E.object [
    ("id", E.int u.id),
    ("name", E.string u.name),
    ("email", E.string u.email),
    ("age", encode_maybe_int u.age),
    ("role", encode_role u.role),
    ("address", encode_address u.address),
    ("tags", E.list_of E.string u.tags),
  ]

pub fun run : Unit -> Unit
run () = {
  dbg "=== Encoding by hand ==="
  let u = User {
    id: 123,
    name: "John Smith",
    email: "john.smith@plymouth.co",
    age: Just 35,
    role: Admin,
    address: Address { street: "123 Fake St", city: "Springfield" },
    tags: ["active", "verified"],
  }
  dbg (E.render (encode_user u))
}
