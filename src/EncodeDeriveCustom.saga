#@ Encoding with `deriving (ToJson)` plus customization via an explicit
#@ `Options` value.
#@
#@ Build an `Options` with the setters (`rename_keys`, `tag_format`,
#@ `omit_nothings`, ...) and pass it as the first argument to
#@ `serialize_with`. Bind it once and reuse it across many calls.
module EncodeDeriveCustom

import SagaJson as J (
  rename_keys,
  omit_nothings,
  tag_format,
  tag_field,
  content_field,
  CamelCase,
  AdjacentlyTagged,
  default_options
)
import SagaJson.Codec as C (ToJson, serialize_with, as_enum, as_tagged)

record User {
  first_name: String,
  last_name: String,
} deriving (Debug, ToJson)

type Status =
  | Active
  | Pending
  | Closed
  deriving (Debug, ToJson)

# Mixed ADT: unit + payload-bearing variants together. Shows the
# per-variant default and how the override strategies treat it.
type Event =
  | Heartbeat
  | Login Int
  | Click Int Int
  deriving (Debug, ToJson)

record Notification {
  message: String,
  details: Maybe String,
} deriving (Debug, ToJson)

pub fun run : Unit -> Unit
run () = {
  dbg "=== Encoding by derive with customization ==="
  # rename_all: emit camelCase keys for snake_case fields. Build the
  # Options value with the setters and pass it as the first argument.
  let camel = rename_keys CamelCase default_options
  dbg (serialize_with camel (User { first_name: "Ada", last_name: "Lovelace" }))

  # tag_format: adjacently-tagged ADT variants. Setters chain with `|>`,
  # so a multi-knob policy reads top-to-bottom.
  let adjacent =
    default_options
    |> tag_format AdjacentlyTagged
    |> tag_field "tag"
    |> content_field "value"
  dbg (serialize_with adjacent Active)

  # omit_nothings: drop `Nothing`-valued `Maybe` fields. Warning: the
  # resulting JSON does NOT round-trip through `deserialize_with` on the
  # same options — the decoder treats a missing field as an error.
  let omit = omit_nothings default_options
  dbg (serialize_with omit (Notification { message: "hello", details: Nothing }))

  # Reuse one Options value across many serializations — bind it once,
  # pass it everywhere.
  let api_shape = default_options |> rename_keys CamelCase |> omit_nothings
  dbg (serialize_with api_shape (User { first_name: "Grace", last_name: "Hopper" }))
  dbg (serialize_with api_shape (Notification { message: "ok", details: Nothing }))
  dbg (serialize_with api_shape Active)

  # as_enum: drop any payload, emit only the variant tag as a bare
  # string. Lossy by design. These take an explicit Options value.
  dbg (C.to_string (as_enum default_options Heartbeat))
  dbg (C.to_string (as_enum default_options (Login 42)))

  # as_tagged: force the externally-tagged `{"V": payload}` shape
  # uniformly, including for unit variants.
  dbg (C.to_string (as_tagged default_options Heartbeat))
  dbg (C.to_string (as_tagged default_options (Login 42)))
}
